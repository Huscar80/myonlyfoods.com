rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then click Publish.
// Each person can only read and change their own profile, recipes and meal plan.
service cloud.firestore {
  match /databases/{database}/documents {

    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // recipes, menu, and anything else stored under a person's profile
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Recipes people chose to make Public. Any signed-in cook can read them;
    // only the recipe's owner can add, change or remove their own.
    match /publicRecipes/{recipeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // One like per person: the record is named after the person who liked it.
      match /likes/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Reports. Anyone signed in can file one (one per recipe, in their own name)
    // and see their own; only you can read them all, in the Firebase console.
    match /reports/{reportId} {
      allow read: if request.auth != null && resource.data.reporterId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid
                    && reportId == request.resource.data.recipeId + "_" + request.auth.uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
