rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // You're an admin if there's a document for you in "admins" (added by hand
    // in the Firebase console, named with your user ID).
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Each person can only read and change their own profile, recipes and meal plan.
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Recipes people chose to make Public. Any signed-in cook can read them;
    // only the owner can share or change their own, unless an admin took it down.
    match /publicRecipes/{recipeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid
                    && !exists(/databases/$(database)/documents/blocked/$(recipeId));
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid
                    && !exists(/databases/$(database)/documents/blocked/$(recipeId));
      allow delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || isAdmin());

      // One like per person: the record is named after the person who liked it.
      match /likes/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Reports. Anyone signed in can file one (one per recipe, in their own name)
    // and see their own; admins can see and update them all.
    match /reports/{reportId} {
      allow read: if request.auth != null && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid
                    && reportId == request.resource.data.recipeId + "_" + request.auth.uid;
      allow update: if isAdmin();
    }

    // Recipes an admin took down. They can't be shared again until restored.
    match /blocked/{recipeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Your own admin record can be checked, but nobody can create one from the site.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
